def setUdFlagSafe = { attr, int udNo, boolean value ->
    def attrName = attr.getName()
    def candidates = [
        [type: "indicator", key: "UD${udNo}"],
        [type: "indicator", key: "USER_DEFINED_${udNo}"],
        [type: "property",  key: "UD${udNo}"],
        [type: "property",  key: "INDICATOR_UD${udNo}"],
        [type: "property",  key: "USER_DEFINED_${udNo}"],
        [type: "property",  key: "INDICATOR_USER_DEFINED_${udNo}"]
    ]

    for (c in candidates) {
        try {
            if (c.type == "indicator") {
                attr.setIndicator(c.key as String, value)
            } else {
                attr.setPropertyValue(c.key as String, value)
            }
            println "    [UD${udNo}] ${attrName} = ${value} (${c.type}:${c.key})"
            return true
        } catch (Exception ignored) {}
    }

    try {
        def pd = attr.getPropertyDefinitions()
        def pdNames = pd.collect { it.getName() }
        def udHints = pdNames.findAll { n ->
            def u = String.valueOf(n).toUpperCase()
            u.contains("UD${udNo}") || (u.contains("USER") && u.contains("${udNo}"))
        }
        println "    [UD${udNo}-WARN] Nelze nastavit pro ${attrName}. Kandidáti API neprošli. Property hints: ${udHints}"
    } catch (Exception ignored3) {
        println "    [UD${udNo}-WARN] Nelze nastavit pro ${attrName}. Kandidáti API neprošli."
    }
    return false
}

def isClobAttribute = { attr ->
    def probes = []

    try { probes << String.valueOf(attr.getDataTypeCode()) } catch (Exception ignored) {}
    try { probes << String.valueOf(attr.getDataType()) } catch (Exception ignored) {}
    try { probes << String.valueOf(attr.getJdbcTypeName()) } catch (Exception ignored) {}

    try {
        def column = attr.getColumn()
        if (column) {
            try { probes << String.valueOf(column.getDataTypeCode()) } catch (Exception ignored2) {}
            try { probes << String.valueOf(column.getDataType()) } catch (Exception ignored2) {}
            try { probes << String.valueOf(column.getJdbcTypeName()) } catch (Exception ignored2) {}
        }
    } catch (Exception ignored) {}

    return probes.findAll { it != null }.any { it.toUpperCase().contains("CLOB") }
}

def getClobColumnsFromDatastore = { ds ->
    def columns = []
    try {
        ds.getColumns().each { col ->
            def probes = []
            try { probes << String.valueOf(col.getDataTypeCode()) } catch (Exception ignored) {}
            try { probes << String.valueOf(col.getDataType()) } catch (Exception ignored) {}
            try { probes << String.valueOf(col.getJdbcTypeName()) } catch (Exception ignored) {}

            def isClob = probes.findAll { it != null }.any { it.toUpperCase().contains("CLOB") }
            if (isClob) {
                columns << col.getName()
            }
        }
    } catch (Exception ignored) {}
    return columns.unique()
}

try {
    def projFinder = (IOdiProjectFinder) t_man.getFinder(OdiProject.class)
    def dsFinder = (IOdiDataStoreFinder) t_man.getFinder(OdiDataStore.class)
    def project = projFinder.findByCode(targetProjectCode)
    def folder = findFolderRecursive(project, targetFolderName)
    def targetIKM = project.getIKMs().find { it.getName() == ikmName }
    if (targetIKM == null) { println "VAROVÁNÍ: IKM ${ikmName} nenalezen" }

    if (!folder) { println "CHYBA: Složka ${targetFolderName} nenalezena"; return }
    if (!applyUdFlags) {
        println "[INFO] UD1/UD2 auto-nastavení je vypnuto; v této ODI verzi nastavujte UD1/UD2 ručně v Mapping Attributes."
    }

    if (scanOnlyClobReport) {
        println "--- CLOB AUDIT (ODS) ---"
        mapList.each { row ->
            def mapName = row[0]; def tgtName = row[2]
            try {
                def tgtCandidates = dsFinder.findByName(tgtName, targetModelName)
                if (!tgtCandidates || !tgtCandidates.iterator().hasNext()) {
                    println "  [WARN] ${mapName} | ${tgtName} | tabulka nenalezena v modelu ${targetModelName}"
                    return
                }
                def tgtDS = tgtCandidates.iterator().next()
                def clobCols = getClobColumnsFromDatastore.call(tgtDS)
                if (!clobCols.isEmpty()) {
                    mappingsWithClobInTarget << [mapping: mapName, target: tgtName, columns: clobCols]
                    println "  [CLOB] ${mapName} | ${tgtName} | sloupce: ${clobCols.join(', ')}"
                }
            } catch (Exception exAudit) {
                println "  [WARN] ${mapName} | ${tgtName} | chyba auditu: ${exAudit.message}"
            }
        }

        if (mappingsWithClobInTarget.isEmpty()) {
            println "[CLOB-SUMMARY] V cílových ODS modelech nebyly detekovány žádné CLOB sloupce."
        } else {
            println "[CLOB-SUMMARY] Přehled tabulek s CLOB v ODS:"
            mappingsWithClobInTarget.each { item ->
                println "  - ${item.target} | CLOB: ${item.columns.join(', ')}"
            }
        }

        tm.commit(txn)
        println "--- HOTOVO (AUDIT ONLY) ---"
        return
    }

    mapList.each { row ->
        def mapName = row[0]; def srcName = row[1]; def tgtName = row[2]
        def tableCode = mapName.replace("INT_OT", "").replace("_SD", "")
        println "--- Zpracovávám: ${mapName} ---"

        try {
            def map = folder.getMappings().find { it.getName() == mapName }
            if (map == null) {
                println "    [INFO] Mapping ${mapName} neexistuje, vytvářím nový"
                map = new Mapping(mapName, folder)
                t_man.persist(map)  // Persistujeme ihned po vytvoření
            } else {
                if (!overwriteExistingMappings) {
                    println "    [SKIP] Mapping ${mapName} existuje a overwriteExistingMappings=false (zachovávám ruční UD nastavení)"
                    return
                }
                println "    [INFO] Mapping ${mapName} nalezen, čistím komponenty"
                if (map.getComponents().size() > 0) {
                    map.getComponents().each { map.removeComponent(it) }
                }
            }

            def srcDS = dsFinder.findByName(srcName, sourceModelName).iterator().next()
            def tgtDS = dsFinder.findByName(tgtName, targetModelName).iterator().next()

            def srcComp = new DatastoreComponent(map, srcDS)
            def tgtComp = new DatastoreComponent(map, tgtDS)
            map.addComponent(srcComp)
            map.addComponent(tgtComp)
            
            // Vytvoření filtru pomocí reflection (jako v IT_OT a IKM)
            def clFiltComp = Class.forName("oracle.odi.domain.mapping.component.FilterComponent")
            def filter = clFiltComp.constructors.find { it.parameterTypes.size() == 2 && it.parameterTypes[1] == String.class }.newInstance(map, "FILTER")
            
            srcComp.getOutputConnectorPoints()[0].connectTo(filter.getInputConnectorPoints()[0])
            filter.getOutputConnectorPoints()[0].connectTo(tgtComp.getInputConnectorPoints()[0])
            
            // Nastavení filtru podle konkrétního INT modelu (např. ITBTER_EFFECTIVE_DATE)
            def expectedEffectiveDateAttr = "IT${tableCode}_EFFECTIVE_DATE".toUpperCase()
            def effectiveDateAttr = srcComp.getAttributes().find {
                it.getName().toUpperCase() == expectedEffectiveDateAttr
            } ?: srcComp.getAttributes().find {
                it.getName().toUpperCase().endsWith("_EFFECTIVE_DATE")
            }

            if (effectiveDateAttr) {
                filter.setFilterCondition("${effectiveDateAttr.getName()} = #VAR_EFFECTIVE_DATE")
            } else {
                filter.setFilterCondition("IT${tableCode}_EFFECTIVE_DATE = #VAR_EFFECTIVE_DATE")
                println "    [VAROVÁNÍ] Nenalezen *_EFFECTIVE_DATE sloupec ve zdroji ${srcName}, použit fallback IT${tableCode}_EFFECTIVE_DATE"
            }

            // LOGIKA MAPPINGU ATRIBUTŮ - SCD2 Slowly Changing Dimension
            def clobColumnsInTarget = []
            tgtComp.getAttributes().each { targetAttr ->
                def name = targetAttr.getName()
                def expr = ""
                def tNameUpper = name.toUpperCase()
                def isCreatedManaged = (tNameUpper.endsWith("_CREATED_DATE") || tNameUpper.endsWith("_CREATED_PROCESS"))
                def isModifiedManaged = (tNameUpper.endsWith("_MODIFIED_DATE") || tNameUpper.endsWith("_MODIFIED_PROCESS"))
                def isCreatedDate = tNameUpper.endsWith("_CREATED_DATE")
                def isModifiedDate = tNameUpper.endsWith("_MODIFIED_DATE")
                def isClobTarget = isClobAttribute.call(targetAttr)

                if (isClobTarget) {
                    clobColumnsInTarget << name
                }
                
                // SCD2 Klíč (ORIG_ID jako INDEX)
                if (name == "OT${tableCode}_ORIG_ID") {
                    try { 
                        targetAttr.setIndicator("INDEX", true) 
                    } catch(e) { 
                        try { 
                            targetAttr.setPropertyValue("INDICATOR_KEY", true) 
                        } catch(e2) {} 
                    }
                }

                // Nastavení výrazů podle typu sloupce
                if (name == "OT${tableCode}_ID") {
                    // Primární klíč ze sekvence
                    expr = ":${targetProjectCode}.OT${tableCode}_ID_SEQ.NEXTVAL"
                }
                else if (name == "OT${tableCode}_ORIG_ID") {
                    // ORIG_ID z ID zdrojové tabulky
                    def origIdCandidates = [
                        "OT${tableCode}_ID",
                        "ITOT${tableCode}_ID",
                        "IT${tableCode}_ID",
                        "${tableCode}_ID"
                    ]
                    def srcOrigId = srcComp.getAttributes().find { a ->
                        origIdCandidates.any { c -> a.getName().equalsIgnoreCase(c) }
                    }
                    if (srcOrigId) {
                        expr = "${srcComp.getName()}.${srcOrigId.getName()}"
                    } else {
                        println "    [VAROVÁNÍ] Nenalezen zdrojový ORIG_ID sloupec pro ${name} (kandidáti: ${origIdCandidates.join(', ')})"
                    }
                }
                else if (isCreatedDate || isModifiedDate) {
                    expr = "SYSDATE"
                }
                else if (tNameUpper.contains("VALID_FROM")) {
                    expr = "#VAR_EFFECTIVE_DATE"
                }
                else if (tNameUpper.contains("VALID_TO")) {
                    expr = "30001231"
                }
                else if (tNameUpper.contains("CURRENT_FLAG")) {
                    expr = "0"
                }
                else if (tNameUpper.contains("PROCESS")) {
                    expr = "<%=odiRef.getSession(\"SESS_NO\")%>"
                }
                else if (tNameUpper.contains("EFFECTIVE_DATE")) {
                    expr = "#BICPR_BT_DWH.VAR_EFFECTIVE_DATE"
                    targetAttr.setPropertyValue("EXECUTE_ON_HINT", "TARGET")
                    targetAttr.setInsertIndicator(true)
                    targetAttr.setUpdateIndicator(true)
                    println "    [SCD] ${name} -> VAR_EFFECTIVE_DATE s Insert/Update"
                }
                else {
                    // Přímé mapování ostatních atributů
                    def base = name.replace("OT${tableCode}_", "")
                    def srcAttr = srcComp.getAttributes().find { 
                        it.getName().toUpperCase() == base || 
                        it.getName().toUpperCase().endsWith("_" + base) ||
                        it.getName().toUpperCase() == "${tableCode}_${base}".toUpperCase()
                    }
                    if (srcAttr) {
                        expr = "${srcComp.getName()}.${srcAttr.getName()}"
                    }
                }
                
                if (expr) {
                    targetAttr.setExpressionText(expr)
                    targetAttr.setPropertyValue("EXECUTE_ON_HINT", "TARGET")

                    if (udDiagnostics && (isCreatedManaged || isModifiedManaged)) {
                        try {
                            def pdNames = targetAttr.getPropertyDefinitions().collect { it.getName() }
                            println "    [UD-DIAG] ${name} property names: ${pdNames}"
                        } catch (Exception ignoredDiag) {
                            println "    [UD-DIAG] ${name} property names nelze načíst"
                        }
                    }

                    def insertFlag = true
                    def updateFlag = true

                    if (isCreatedManaged) {
                        insertFlag = true
                        updateFlag = false
                        if (applyUdFlags) {
                            setUdFlagSafe.call(targetAttr, 1, true)
                            setUdFlagSafe.call(targetAttr, 2, false)
                        }
                    } else if (isModifiedManaged) {
                        insertFlag = false
                        updateFlag = true
                        if (applyUdFlags) {
                            setUdFlagSafe.call(targetAttr, 1, false)
                            setUdFlagSafe.call(targetAttr, 2, true)
                        }
                    }

                    targetAttr.setInsertIndicator(insertFlag)
                    targetAttr.setUpdateIndicator(updateFlag)
                }
            }

            if (!clobColumnsInTarget.isEmpty()) {
                def clobUnique = clobColumnsInTarget.unique()
                mappingsWithClobInTarget << [mapping: mapName, target: tgtName, columns: clobUnique]
                println "    [CLOB] ODS ${tgtName} obsahuje CLOB sloupce: ${clobUnique.join(', ')}"
            }

            // FYZICKÁ ÚROVEŇ (IKM a Parametry)
            map.getPhysicalDesigns().each { phys ->
                phys.getPhysicalNodes().each { node ->
                    if (node.isTargetNode()) {
                        if (targetIKM) node.setIKM(targetIKM)

                        // Nastavení parametrů IKM pro SCD
                        node.getIKMOptionValues().each { opt ->
                            def n = opt.getName()
                            if (n == "FLOW_CONTROL") opt.setValue(false)
                            if (n == "UPDATE" || n == "DELETE") opt.setValue(false)
                            if (n == "INSERT" || n == "COMMIT") opt.setValue(true)
                        }
                    }
                }
            }
            t_man.persist(map)
            println "    [OK] Mapping uložen"
        } catch (Exception ex) {
            println "    [CHYBA] ${ex.message}"
        }
    }

    if (mappingsWithClobInTarget.isEmpty()) {
        println "[CLOB-SUMMARY] V cílových ODS modelech nebyly detekovány žádné CLOB sloupce."
    } else {
        println "[CLOB-SUMMARY] Přehled mappingů s CLOB v cílovém ODS modelu:"
        mappingsWithClobInTarget.each { item ->
            println "  - ${item.mapping} | ${item.target} | CLOB: ${item.columns.join(', ')}"
        }
    }

    tm.commit(txn)
    println "--- HOTOVO ---"
} catch (e) {
    if (txn) tm.rollback(txn)
    e.printStackTrace()
}
