-- INT
select ittops_effective_date,ittops_effective_date_minute,count(*) pocet
from ownbt_int.INT_RDT_TOPS
where ittops_effective_date>20260228
group by ittops_effective_date,ittops_effective_date_minute
order by 1
; 

-- ODS
select ottops_valid_from_minute,count(*) pocet
from ownbt_ods.ODT_RDT_TOPS
where ottops_valid_from_minute>202602280000
group by ottops_valid_from_minute
order by 1
;

